@model Instrumento

@{
    ViewData["Title"] = "Detalle: Instrumento";
}

<h1 class="h3">Detalle: Instrumento</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdInstrumento)</dd>
    <dt class="col-sm-3">Nombre de familia</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NombreFamilia)</dd>
    <dt class="col-sm-3">Versión</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Version)</dd>
    <dt class="col-sm-3">Método</dt>
    <dd class="col-sm-9">@Model.Metodo?.Nombre</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Estado)</dd>
    <dt class="col-sm-3">Instrumento anterior</dt>
    <dd class="col-sm-9">@Model.InstrumentoAnterior?.NombreFamilia</dd>
    <dt class="col-sm-3">Fecha de versión</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaVersion))</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdInstrumento" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
