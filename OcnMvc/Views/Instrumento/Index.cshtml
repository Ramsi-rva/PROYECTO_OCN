@model IEnumerable<Instrumento>

@{
    ViewData["Title"] = "Instrumentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Instrumentos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>
<p class="text-muted small">Solo se muestran los registros activos.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Nombre de familia</th>
            <th>Versión</th>
            <th>Método</th>
            <th>Estado</th>
            <th>Instrumento anterior</th>
            <th>Fecha de versión</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdInstrumento</td>
                <td>@Html.DisplayFor(_ => item.NombreFamilia)</td>
                <td>@Html.DisplayFor(_ => item.Version)</td>
                <td>@item.Metodo?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.Estado)</td>
                <td>@item.InstrumentoAnterior?.NombreFamilia</td>
                <td>@(string.Format("{0:dd/MM/yyyy}", item.FechaVersion))</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdInstrumento" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdInstrumento" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdInstrumento" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
