@model IEnumerable<RecursoZonaAccesibilidad>

@{
    ViewData["Title"] = "Accesibilidad de recursos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Accesibilidad de recursos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Recurso</th>
            <th>Zona</th>
            <th>Nivel de accesibilidad percibida</th>
            <th>Fecha de evaluación</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdRecursoZonaAccesibilidad</td>
                <td>@item.Recurso?.Nombre</td>
                <td>@item.Zona?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.NivelAccesibilidadPercibida)</td>
                <td>@(string.Format("{0:dd/MM/yyyy}", item.FechaEvaluacion))</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdRecursoZonaAccesibilidad" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdRecursoZonaAccesibilidad" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdRecursoZonaAccesibilidad" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
