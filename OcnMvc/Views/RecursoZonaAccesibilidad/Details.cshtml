@model RecursoZonaAccesibilidad

@{
    ViewData["Title"] = "Detalle: Accesibilidad de recurso";
}

<h1 class="h3">Detalle: Accesibilidad de recurso</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdRecursoZonaAccesibilidad)</dd>
    <dt class="col-sm-3">Recurso</dt>
    <dd class="col-sm-9">@Model.Recurso?.Nombre</dd>
    <dt class="col-sm-3">Zona</dt>
    <dd class="col-sm-9">@Model.Zona?.Nombre</dd>
    <dt class="col-sm-3">Nivel de accesibilidad percibida</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NivelAccesibilidadPercibida)</dd>
    <dt class="col-sm-3">Fecha de evaluación</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaEvaluacion))</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdRecursoZonaAccesibilidad" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
