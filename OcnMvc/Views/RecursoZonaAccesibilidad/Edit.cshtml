@model RecursoZonaAccesibilidad

@{
    ViewData["Title"] = "Editar: Accesibilidad de recurso";
}

<h1 class="h3">Editar: Accesibilidad de recurso</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Edit" asp-route-id="@Model.IdRecursoZonaAccesibilidad" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="IdRecursoZonaAccesibilidad" />
    <div class="mb-3">
        <label asp-for="IdRecurso" class="form-label">Recurso</label>
        <select asp-for="IdRecurso" asp-items="ViewBag.IdRecurso" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdZona" class="form-label">Zona</label>
        <select asp-for="IdZona" asp-items="ViewBag.IdZona" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdZona" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NivelAccesibilidadPercibida" class="form-label">Nivel de accesibilidad percibida</label>
        <input asp-for="NivelAccesibilidadPercibida" class="form-control" />
        <span asp-validation-for="NivelAccesibilidadPercibida" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaEvaluacion" class="form-label">Fecha de evaluación</label>
        <input asp-for="FechaEvaluacion" type="date" class="form-control" />
        <span asp-validation-for="FechaEvaluacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
