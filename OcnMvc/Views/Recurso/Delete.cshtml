@model Recurso

@{
    ViewData["Title"] = "Eliminar: Recurso";
}

<h1 class="h3">¿Seguro que quieres eliminar este registro?</h1>
<div class="alert alert-warning">El registro no se borra de la base de datos: se marca como inactivo y deja de aparecer en la lista.</div>

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdRecurso)</dd>
    <dt class="col-sm-3">Código de recurso</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.CodigoRecurso)</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Nombre)</dd>
    <dt class="col-sm-3">Tipo de recurso</dt>
    <dd class="col-sm-9">@Model.TipoRecurso?.Nombre</dd>
    <dt class="col-sm-3">Organización responsable</dt>
    <dd class="col-sm-9">@Model.OrganizacionResponsable?.Nombre</dd>
    <dt class="col-sm-3">Estado de recurso</dt>
    <dd class="col-sm-9">@Model.EstadoRecurso?.Nombre</dd>
    <dt class="col-sm-3">Costo de recurso</dt>
    <dd class="col-sm-9">@Model.CostoRecurso?.Nombre</dd>
    <dt class="col-sm-3">Horario general</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.HorarioGeneral)</dd>
    <dt class="col-sm-3">Capacidad aproximada</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.CapacidadAproximada)</dd>
    <dt class="col-sm-3">Conocimiento de la comunidad</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.ConocimientoComunidad)</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdRecurso" method="post">
    <input type="hidden" asp-for="IdRecurso" />
    <button type="submit" class="btn btn-danger">Dar de baja</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
