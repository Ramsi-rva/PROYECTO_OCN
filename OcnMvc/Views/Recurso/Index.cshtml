@model IEnumerable<Recurso>

@{
    ViewData["Title"] = "Recursos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Recursos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>
<p class="text-muted small">Solo se muestran los registros activos.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Código de recurso</th>
            <th>Nombre</th>
            <th>Tipo de recurso</th>
            <th>Organización responsable</th>
            <th>Estado de recurso</th>
            <th>Costo de recurso</th>
            <th>Horario general</th>
            <th>Capacidad aproximada</th>
            <th>Conocimiento de la comunidad</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdRecurso</td>
                <td>@Html.DisplayFor(_ => item.CodigoRecurso)</td>
                <td>@Html.DisplayFor(_ => item.Nombre)</td>
                <td>@item.TipoRecurso?.Nombre</td>
                <td>@item.OrganizacionResponsable?.Nombre</td>
                <td>@item.EstadoRecurso?.Nombre</td>
                <td>@item.CostoRecurso?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.HorarioGeneral)</td>
                <td>@Html.DisplayFor(_ => item.CapacidadAproximada)</td>
                <td>@Html.DisplayFor(_ => item.ConocimientoComunidad)</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdRecurso" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdRecurso" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdRecurso" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
