@model Recurso

@{
    ViewData["Title"] = "Editar: Recurso";
}

<h1 class="h3">Editar: Recurso</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Edit" asp-route-id="@Model.IdRecurso" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="IdRecurso" />
    <div class="mb-3">
        <label asp-for="CodigoRecurso" class="form-label">Código de recurso</label>
        <input asp-for="CodigoRecurso" class="form-control" />
        <span asp-validation-for="CodigoRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdTipoRecurso" class="form-label">Tipo de recurso</label>
        <select asp-for="IdTipoRecurso" asp-items="ViewBag.IdTipoRecurso" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdTipoRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdOrganizacionResponsable" class="form-label">Organización responsable</label>
        <select asp-for="IdOrganizacionResponsable" asp-items="ViewBag.IdOrganizacionResponsable" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdOrganizacionResponsable" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdEstadoRecurso" class="form-label">Estado de recurso</label>
        <select asp-for="IdEstadoRecurso" asp-items="ViewBag.IdEstadoRecurso" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdEstadoRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdCostoRecurso" class="form-label">Costo de recurso</label>
        <select asp-for="IdCostoRecurso" asp-items="ViewBag.IdCostoRecurso" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdCostoRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HorarioGeneral" class="form-label">Horario general</label>
        <input asp-for="HorarioGeneral" class="form-control" />
        <span asp-validation-for="HorarioGeneral" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CapacidadAproximada" class="form-label">Capacidad aproximada</label>
        <input asp-for="CapacidadAproximada" class="form-control" />
        <span asp-validation-for="CapacidadAproximada" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConocimientoComunidad" class="form-label">Conocimiento de la comunidad</label>
        <input asp-for="ConocimientoComunidad" class="form-control" />
        <span asp-validation-for="ConocimientoComunidad" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label">Activo</label>
        <span asp-validation-for="Activo" class="text-danger d-block"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
