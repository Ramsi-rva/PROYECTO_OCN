@model Usuario

@{
    ViewData["Title"] = "Detalle: Usuario";
}

<h1 class="h3">Detalle: Usuario</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdUsuario)</dd>
    <dt class="col-sm-3">Nombre de usuario</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NombreUsuario)</dd>
    <dt class="col-sm-3">Nombre completo</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NombreCompleto)</dd>
    <dt class="col-sm-3">Correo institucional</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.CorreoInstitucional)</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
    <dt class="col-sm-3">Fecha de alta</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy HH:mm}", Model.FechaAlta))</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
