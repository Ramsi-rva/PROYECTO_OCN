@model ObservacionProblematica

@{
    ViewData["Title"] = "Editar: Problemática observada";
}

<h1 class="h3">Editar: Problemática observada</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Edit" asp-route-id="@Model.IdObservacionProblematica" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="IdObservacionProblematica" />
    <div class="mb-3">
        <label asp-for="IdObservacion" class="form-label">Observación</label>
        <select asp-for="IdObservacion" asp-items="ViewBag.IdObservacion" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdObservacion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdProblematica" class="form-label">Problemática</label>
        <select asp-for="IdProblematica" asp-items="ViewBag.IdProblematica" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdProblematica" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdMagnitud" class="form-label">Magnitud</label>
        <select asp-for="IdMagnitud" asp-items="ViewBag.IdMagnitud" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdMagnitud" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdGravedad" class="form-label">Gravedad</label>
        <select asp-for="IdGravedad" asp-items="ViewBag.IdGravedad" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdGravedad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdFrecuencia" class="form-label">Frecuencia</label>
        <select asp-for="IdFrecuencia" asp-items="ViewBag.IdFrecuencia" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdFrecuencia" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NivelConfianza" class="form-label">Nivel de confianza</label>
        <input asp-for="NivelConfianza" class="form-control" />
        <span asp-validation-for="NivelConfianza" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
