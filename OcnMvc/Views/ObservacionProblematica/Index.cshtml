@model IEnumerable<ObservacionProblematica>

@{
    ViewData["Title"] = "Problemáticas observadas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Problemáticas observadas</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Observación</th>
            <th>Problemática</th>
            <th>Magnitud</th>
            <th>Gravedad</th>
            <th>Frecuencia</th>
            <th>Nivel de confianza</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdObservacionProblematica</td>
                <td>@item.Observacion?.NotaContexto</td>
                <td>@item.Problematica?.Nombre</td>
                <td>@item.Magnitud?.Nombre</td>
                <td>@item.Gravedad?.Nombre</td>
                <td>@item.Frecuencia?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.NivelConfianza)</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdObservacionProblematica" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdObservacionProblematica" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdObservacionProblematica" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
