<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OCN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OcnMvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="~/">OCN</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="menu-territorio" role="button" data-bs-toggle="dropdown" aria-expanded="false">Territorio</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-territorio">
                                <li><a class="dropdown-item" asp-controller="Zona" asp-action="Index">Zonas</a></li>
                                <li><a class="dropdown-item" asp-controller="DivisionTerritorial" asp-action="Index">Divisiones territoriales</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoZona" asp-action="Index">Tipos de zona</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="menu-levantamientos" role="button" data-bs-toggle="dropdown" aria-expanded="false">Levantamientos</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-levantamientos">
                                <li><a class="dropdown-item" asp-controller="Periodo" asp-action="Index">Periodos</a></li>
                                <li><a class="dropdown-item" asp-controller="Levantamiento" asp-action="Index">Levantamientos</a></li>
                                <li><a class="dropdown-item" asp-controller="Instrumento" asp-action="Index">Instrumentos</a></li>
                                <li><a class="dropdown-item" asp-controller="CatMetodo" asp-action="Index">Métodos</a></li>
                                <li><a class="dropdown-item" asp-controller="Observacion" asp-action="Index">Observaciones</a></li>
                                <li><a class="dropdown-item" asp-controller="Fuente" asp-action="Index">Fuentes</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoFuente" asp-action="Index">Tipos de fuente</a></li>
                                <li><a class="dropdown-item" asp-controller="Organizacion" asp-action="Index">Organizaciones</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoOrganizacion" asp-action="Index">Tipos de organización</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="menu-problemáticas" role="button" data-bs-toggle="dropdown" aria-expanded="false">Problemáticas</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-problemáticas">
                                <li><a class="dropdown-item" asp-controller="Problematica" asp-action="Index">Problemáticas</a></li>
                                <li><a class="dropdown-item" asp-controller="CategoriaProblematica" asp-action="Index">Categorías de problemática</a></li>
                                <li><a class="dropdown-item" asp-controller="ObservacionProblematica" asp-action="Index">Problemáticas observadas</a></li>
                                <li><a class="dropdown-item" asp-controller="Evidencia" asp-action="Index">Evidencias</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoEvidencia" asp-action="Index">Tipos de evidencia</a></li>
                                <li><a class="dropdown-item" asp-controller="CatMagnitud" asp-action="Index">Magnitudes</a></li>
                                <li><a class="dropdown-item" asp-controller="CatGravedad" asp-action="Index">Gravedades</a></li>
                                <li><a class="dropdown-item" asp-controller="CatFrecuencia" asp-action="Index">Frecuencias</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTendencia" asp-action="Index">Tendencias</a></li>
                                <li><a class="dropdown-item" asp-controller="CatFactorRiesgo" asp-action="Index">Factores de riesgo</a></li>
                                <li><a class="dropdown-item" asp-controller="CatFactorProtector" asp-action="Index">Factores protectores</a></li>
                                <li><a class="dropdown-item" asp-controller="CatGrupoPoblacional" asp-action="Index">Grupos poblacionales</a></li>
                                <li><a class="dropdown-item" asp-controller="Necesidad" asp-action="Index">Necesidades</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoIntervencion" asp-action="Index">Tipos de intervención</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="menu-recursos" role="button" data-bs-toggle="dropdown" aria-expanded="false">Recursos</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-recursos">
                                <li><a class="dropdown-item" asp-controller="Recurso" asp-action="Index">Recursos</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoRecurso" asp-action="Index">Tipos de recurso</a></li>
                                <li><a class="dropdown-item" asp-controller="CatEstadoRecurso" asp-action="Index">Estados de recurso</a></li>
                                <li><a class="dropdown-item" asp-controller="CatCostoRecurso" asp-action="Index">Costos de recurso</a></li>
                                <li><a class="dropdown-item" asp-controller="CatServicio" asp-action="Index">Servicios</a></li>
                                <li><a class="dropdown-item" asp-controller="RecursoZonaCobertura" asp-action="Index">Coberturas de recursos</a></li>
                                <li><a class="dropdown-item" asp-controller="CatTipoCobertura" asp-action="Index">Tipos de cobertura</a></li>
                                <li><a class="dropdown-item" asp-controller="RecursoZonaBarrera" asp-action="Index">Barreras de acceso</a></li>
                                <li><a class="dropdown-item" asp-controller="CatBarrera" asp-action="Index">Tipos de barrera</a></li>
                                <li><a class="dropdown-item" asp-controller="RecursoZonaAccesibilidad" asp-action="Index">Accesibilidad de recursos</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="menu-priorización" role="button" data-bs-toggle="dropdown" aria-expanded="false">Priorización</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-priorización">
                                <li><a class="dropdown-item" asp-controller="ModeloPriorizacion" asp-action="Index">Modelos de priorización</a></li>
                                <li><a class="dropdown-item" asp-controller="ModeloPonderacion" asp-action="Index">Ponderaciones</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="menu-administración" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-administración">
                                <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                                <li><a class="dropdown-item" asp-controller="Rol" asp-action="Index">Roles</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OCN
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
