@model IEnumerable<Levantamiento>

@{
    ViewData["Title"] = "Levantamientos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Levantamientos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Código de levantamiento</th>
            <th>Zona</th>
            <th>Periodo</th>
            <th>Método</th>
            <th>Fecha de levantamiento</th>
            <th>Número de participantes aprox.</th>
            <th>Fecha de captura</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdLevantamiento</td>
                <td>@Html.DisplayFor(_ => item.CodigoLevantamiento)</td>
                <td>@item.Zona?.Nombre</td>
                <td>@item.Periodo?.Nombre</td>
                <td>@item.Metodo?.Nombre</td>
                <td>@(string.Format("{0:dd/MM/yyyy}", item.FechaLevantamiento))</td>
                <td>@Html.DisplayFor(_ => item.NumeroParticipantesAprox)</td>
                <td>@(string.Format("{0:dd/MM/yyyy HH:mm}", item.FechaCaptura))</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdLevantamiento" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdLevantamiento" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdLevantamiento" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
