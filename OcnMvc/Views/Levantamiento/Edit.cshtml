@model Levantamiento

@{
    ViewData["Title"] = "Editar: Levantamiento";
}

<h1 class="h3">Editar: Levantamiento</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Edit" asp-route-id="@Model.IdLevantamiento" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="IdLevantamiento" />
    <div class="mb-3">
        <label asp-for="CodigoLevantamiento" class="form-label">Código de levantamiento</label>
        <input asp-for="CodigoLevantamiento" class="form-control" />
        <span asp-validation-for="CodigoLevantamiento" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdZona" class="form-label">Zona</label>
        <select asp-for="IdZona" asp-items="ViewBag.IdZona" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdZona" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdPeriodo" class="form-label">Periodo</label>
        <select asp-for="IdPeriodo" asp-items="ViewBag.IdPeriodo" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdPeriodo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdMetodo" class="form-label">Método</label>
        <select asp-for="IdMetodo" asp-items="ViewBag.IdMetodo" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdMetodo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaLevantamiento" class="form-label">Fecha de levantamiento</label>
        <input asp-for="FechaLevantamiento" type="date" class="form-control" />
        <span asp-validation-for="FechaLevantamiento" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NumeroParticipantesAprox" class="form-label">Número de participantes aprox.</label>
        <input asp-for="NumeroParticipantesAprox" class="form-control" />
        <span asp-validation-for="NumeroParticipantesAprox" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ObservacionesMetodologicas" class="form-label">Observaciones metodológicas</label>
        <textarea asp-for="ObservacionesMetodologicas" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ObservacionesMetodologicas" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaCaptura" class="form-label">Fecha de captura</label>
        <input asp-for="FechaCaptura" class="form-control" />
        <span asp-validation-for="FechaCaptura" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
