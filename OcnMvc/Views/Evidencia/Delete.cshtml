@model Evidencia

@{
    ViewData["Title"] = "Eliminar: Evidencia";
}

<h1 class="h3">¿Seguro que quieres eliminar este registro?</h1>
<div class="alert alert-warning">Esta acción elimina el registro de la base de datos de forma permanente.</div>

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdEvidencia)</dd>
    <dt class="col-sm-3">Problemática observada</dt>
    <dd class="col-sm-9">@Model.ObservacionProblematica?.IdObservacionProblematica</dd>
    <dt class="col-sm-3">Tipo de evidencia</dt>
    <dd class="col-sm-9">@Model.TipoEvidencia?.Nombre</dd>
    <dt class="col-sm-3">Fuente</dt>
    <dd class="col-sm-9">@Model.Fuente?.Descripcion</dd>
    <dt class="col-sm-3">Número de menciones</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NumeroMenciones)</dd>
    <dt class="col-sm-3">Descripción breve</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.DescripcionBreve)</dd>
    <dt class="col-sm-3">Fecha de registro</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy HH:mm}", Model.FechaRegistro))</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdEvidencia" method="post">
    <input type="hidden" asp-for="IdEvidencia" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
