@model Problematica

@{
    ViewData["Title"] = "Eliminar: Problemática";
}

<h1 class="h3">¿Seguro que quieres eliminar este registro?</h1>
<div class="alert alert-warning">El registro no se borra de la base de datos: se marca como inactivo y deja de aparecer en la lista.</div>

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdProblematica)</dd>
    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria?.Nombre</dd>
    <dt class="col-sm-3">Problemática padre</dt>
    <dd class="col-sm-9">@Model.ProblematicaPadre?.Nombre</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Nombre)</dd>
    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Descripcion)</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdProblematica" method="post">
    <input type="hidden" asp-for="IdProblematica" />
    <button type="submit" class="btn btn-danger">Dar de baja</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
