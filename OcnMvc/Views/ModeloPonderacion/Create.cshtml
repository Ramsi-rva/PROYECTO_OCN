@model ModeloPonderacion

@{
    ViewData["Title"] = "Nuevo: Ponderación";
}

<h1 class="h3">Nuevo: Ponderación</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="IdModelo" class="form-label">Modelo</label>
        <select asp-for="IdModelo" asp-items="ViewBag.IdModelo" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdModelo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Variable" class="form-label">Variable</label>
        <input asp-for="Variable" class="form-control" />
        <span asp-validation-for="Variable" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Peso" class="form-label">Peso</label>
        <input asp-for="Peso" class="form-control" />
        <span asp-validation-for="Peso" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
