@model IEnumerable<ModeloPonderacion>

@{
    ViewData["Title"] = "Ponderaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ponderaciones</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Modelo</th>
            <th>Variable</th>
            <th>Peso</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Modelo?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.Variable)</td>
                <td>@Html.DisplayFor(_ => item.Peso)</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-idModelo="@item.IdModelo" asp-route-variable="@item.Variable" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-idModelo="@item.IdModelo" asp-route-variable="@item.Variable" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-idModelo="@item.IdModelo" asp-route-variable="@item.Variable" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
