@model ModeloPonderacion

@{
    ViewData["Title"] = "Detalle: Ponderación";
}

<h1 class="h3">Detalle: Ponderación</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Modelo?.Nombre</dd>
    <dt class="col-sm-3">Variable</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Variable)</dd>
    <dt class="col-sm-3">Peso</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Peso)</dd>
</dl>

<a asp-action="Edit" asp-route-idModelo="@Model.IdModelo" asp-route-variable="@Model.Variable" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
