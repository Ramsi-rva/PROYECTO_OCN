@model IEnumerable<Zona>

@{
    ViewData["Title"] = "Zonas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Zonas</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>
<p class="text-muted small">Solo se muestran los registros activos.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Código de zona</th>
            <th>Nombre</th>
            <th>División</th>
            <th>Tipo de zona</th>
            <th>Referencia geográfica aprox.</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdZona</td>
                <td>@Html.DisplayFor(_ => item.CodigoZona)</td>
                <td>@Html.DisplayFor(_ => item.Nombre)</td>
                <td>@item.Division?.Nombre</td>
                <td>@item.TipoZona?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.ReferenciaGeograficaAprox)</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdZona" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdZona" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdZona" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
