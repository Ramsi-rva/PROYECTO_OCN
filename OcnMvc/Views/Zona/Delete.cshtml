@model Zona

@{
    ViewData["Title"] = "Eliminar: Zona";
}

<h1 class="h3">¿Seguro que quieres eliminar este registro?</h1>
<div class="alert alert-warning">El registro no se borra de la base de datos: se marca como inactivo y deja de aparecer en la lista.</div>

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdZona)</dd>
    <dt class="col-sm-3">Código de zona</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.CodigoZona)</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Nombre)</dd>
    <dt class="col-sm-3">División</dt>
    <dd class="col-sm-9">@Model.Division?.Nombre</dd>
    <dt class="col-sm-3">Tipo de zona</dt>
    <dd class="col-sm-9">@Model.TipoZona?.Nombre</dd>
    <dt class="col-sm-3">Descripción general</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.DescripcionGeneral)</dd>
    <dt class="col-sm-3">Referencia geográfica aprox.</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.ReferenciaGeograficaAprox)</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdZona" method="post">
    <input type="hidden" asp-for="IdZona" />
    <button type="submit" class="btn btn-danger">Dar de baja</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
