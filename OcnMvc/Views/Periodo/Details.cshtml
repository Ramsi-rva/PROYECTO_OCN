@model Periodo

@{
    ViewData["Title"] = "Detalle: Periodo";
}

<h1 class="h3">Detalle: Periodo</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdPeriodo)</dd>
    <dt class="col-sm-3">Código de periodo</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.CodigoPeriodo)</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Nombre)</dd>
    <dt class="col-sm-3">Fecha de inicio</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaInicio))</dd>
    <dt class="col-sm-3">Fecha de fin</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaFin))</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdPeriodo" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
