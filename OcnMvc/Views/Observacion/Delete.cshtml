@model Observacion

@{
    ViewData["Title"] = "Eliminar: Observación";
}

<h1 class="h3">¿Seguro que quieres eliminar este registro?</h1>
<div class="alert alert-warning">Esta acción elimina el registro de la base de datos de forma permanente.</div>

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdObservacion)</dd>
    <dt class="col-sm-3">Levantamiento</dt>
    <dd class="col-sm-9">@Model.Levantamiento?.CodigoLevantamiento</dd>
    <dt class="col-sm-3">Nota de contexto</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NotaContexto)</dd>
    <dt class="col-sm-3">Fecha de registro</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy HH:mm}", Model.FechaRegistro))</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdObservacion" method="post">
    <input type="hidden" asp-for="IdObservacion" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
