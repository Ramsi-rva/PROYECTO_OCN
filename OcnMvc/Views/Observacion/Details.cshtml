@model Observacion

@{
    ViewData["Title"] = "Detalle: Observación";
}

<h1 class="h3">Detalle: Observación</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdObservacion)</dd>
    <dt class="col-sm-3">Levantamiento</dt>
    <dd class="col-sm-9">@Model.Levantamiento?.CodigoLevantamiento</dd>
    <dt class="col-sm-3">Nota de contexto</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.NotaContexto)</dd>
    <dt class="col-sm-3">Fecha de registro</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy HH:mm}", Model.FechaRegistro))</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdObservacion" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
