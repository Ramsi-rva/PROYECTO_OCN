@model RecursoZonaBarrera

@{
    ViewData["Title"] = "Detalle: Barrera de acceso";
}

<h1 class="h3">Detalle: Barrera de acceso</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdRecursoZonaBarrera)</dd>
    <dt class="col-sm-3">Recurso</dt>
    <dd class="col-sm-9">@Model.Recurso?.Nombre</dd>
    <dt class="col-sm-3">Zona</dt>
    <dd class="col-sm-9">@Model.Zona?.Nombre</dd>
    <dt class="col-sm-3">Barrera</dt>
    <dd class="col-sm-9">@Model.Barrera?.Nombre</dd>
    <dt class="col-sm-3">Grupo poblacional</dt>
    <dd class="col-sm-9">@Model.GrupoPoblacional?.Nombre</dd>
    <dt class="col-sm-3">Fecha de registro</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaRegistro))</dd>
    <dt class="col-sm-3">Notas</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.Notas)</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdRecursoZonaBarrera" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
