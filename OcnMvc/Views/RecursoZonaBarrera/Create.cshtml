@model RecursoZonaBarrera

@{
    ViewData["Title"] = "Nuevo: Barrera de acceso";
}

<h1 class="h3">Nuevo: Barrera de acceso</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="IdRecurso" class="form-label">Recurso</label>
        <select asp-for="IdRecurso" asp-items="ViewBag.IdRecurso" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdZona" class="form-label">Zona</label>
        <select asp-for="IdZona" asp-items="ViewBag.IdZona" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdZona" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdBarrera" class="form-label">Barrera</label>
        <select asp-for="IdBarrera" asp-items="ViewBag.IdBarrera" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdBarrera" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdGrupoPoblacional" class="form-label">Grupo poblacional</label>
        <select asp-for="IdGrupoPoblacional" asp-items="ViewBag.IdGrupoPoblacional" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdGrupoPoblacional" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaRegistro" class="form-label">Fecha de registro</label>
        <input asp-for="FechaRegistro" type="date" class="form-control" />
        <span asp-validation-for="FechaRegistro" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Notas" class="form-label">Notas</label>
        <textarea asp-for="Notas" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notas" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
