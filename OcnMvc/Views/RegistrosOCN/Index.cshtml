@model IEnumerable<RegistroOCN>

@{
    ViewData["Title"] = "Registros OCN";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Registros OCN</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay registros.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>@Html.DisplayNameFor(m => m.Zona)</th>
            <th>@Html.DisplayNameFor(m => m.Problematica)</th>
            <th>@Html.DisplayNameFor(m => m.FechaRegistro)</th>
            <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdRegistroOCN</td>
                <td>@item.Zona?.Nombre</td>
                <td>@item.Problematica?.Nombre</td>
                <td>@Html.DisplayFor(_ => item.FechaRegistro)</td>
                <td>@item.Descripcion</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdRegistroOCN" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdRegistroOCN" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdRegistroOCN" class="btn btn-sm btn-outline-danger">Dar de baja</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
}
