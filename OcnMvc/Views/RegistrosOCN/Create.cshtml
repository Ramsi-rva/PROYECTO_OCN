@model RegistroOCN

@{
    ViewData["Title"] = "Nuevo registro OCN";
}

<h1 class="h3">Nuevo registro OCN</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Create" method="post">
    @* El tag helper <form method="post"> agrega el AntiForgeryToken (campo oculto __RequestVerificationToken) *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="IdZona" class="form-label"></label>
        <select asp-for="IdZona" asp-items="ViewBag.IdZona" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdZona" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdProblematica" class="form-label"></label>
        <select asp-for="IdProblematica" asp-items="ViewBag.IdProblematica" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdProblematica" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="Intensidad" class="form-label"></label>
            <select asp-for="Intensidad" asp-items="ViewBag.Intensidad" class="form-select"></select>
            <div class="form-text">1 = muy baja, 5 = muy alta</div>
            <span asp-validation-for="Intensidad" class="text-danger"></span>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="Frecuencia" class="form-label"></label>
            <select asp-for="Frecuencia" asp-items="ViewBag.Frecuencia" class="form-select"></select>
            <span asp-validation-for="Frecuencia" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="FechaRegistro" class="form-label"></label>
        @if (Model == null)
        {
            @* Registro nuevo: se propone la fecha y hora actuales *@
            <input type="datetime-local" id="FechaRegistro" name="FechaRegistro" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
        }
        else
        {
            <input asp-for="FechaRegistro" class="form-control" />
        }
        <span asp-validation-for="FechaRegistro" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
