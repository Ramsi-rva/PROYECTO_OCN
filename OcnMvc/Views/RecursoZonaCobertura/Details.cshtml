@model RecursoZonaCobertura

@{
    ViewData["Title"] = "Detalle: Cobertura de recurso";
}

<h1 class="h3">Detalle: Cobertura de recurso</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">#</dt>
    <dd class="col-sm-9">@Html.DisplayFor(_ => Model.IdRecursoZonaCobertura)</dd>
    <dt class="col-sm-3">Recurso</dt>
    <dd class="col-sm-9">@Model.Recurso?.Nombre</dd>
    <dt class="col-sm-3">Zona</dt>
    <dd class="col-sm-9">@Model.Zona?.Nombre</dd>
    <dt class="col-sm-3">Tipo de cobertura</dt>
    <dd class="col-sm-9">@Model.TipoCobertura?.Nombre</dd>
    <dt class="col-sm-3">Fecha de inicio</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaInicio))</dd>
    <dt class="col-sm-3">Fecha de fin</dt>
    <dd class="col-sm-9">@(string.Format("{0:dd/MM/yyyy}", Model.FechaFin))</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdRecursoZonaCobertura" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
