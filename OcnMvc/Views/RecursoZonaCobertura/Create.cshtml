@model RecursoZonaCobertura

@{
    ViewData["Title"] = "Nuevo: Cobertura de recurso";
}

<h1 class="h3">Nuevo: Cobertura de recurso</h1>
<hr />

<div class="row">
<div class="col-md-8 col-lg-6">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="IdRecurso" class="form-label">Recurso</label>
        <select asp-for="IdRecurso" asp-items="ViewBag.IdRecurso" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdRecurso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdZona" class="form-label">Zona</label>
        <select asp-for="IdZona" asp-items="ViewBag.IdZona" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdZona" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdTipoCobertura" class="form-label">Tipo de cobertura</label>
        <select asp-for="IdTipoCobertura" asp-items="ViewBag.IdTipoCobertura" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdTipoCobertura" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaInicio" class="form-label">Fecha de inicio</label>
        <input asp-for="FechaInicio" type="date" class="form-control" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaFin" class="form-label">Fecha de fin</label>
        <input asp-for="FechaFin" type="date" class="form-control" />
        <span asp-validation-for="FechaFin" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
